# ---- 模型 ----
# auto = 没检测到 key 时自动走 mock（零成本跑通链路，推荐先这样验证）
# mock = 强制假模型   live = 强制真实模型
LLM_MODE=auto

# 档位：fast 用于改写/分类/打分，smart 用于最终生成
MODEL_FAST=deepseek/deepseek-chat
MODEL_SMART=deepseek/deepseek-chat
# 备用模型：主模型超时或失败时自动切换
MODEL_FALLBACK=ollama/qwen2.5:7b

# 只填你要用的那一个
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 本地 ollama 需要这个地址（默认即可）
OLLAMA_API_BASE=http://localhost:11434

# ---- 数据库 ----
# 开发用 sqlite，部署换成 postgresql+psycopg://user:pass@localhost:5432/kb
DATABASE_URL=sqlite:///./kb_agent.db

# ---- 向量库 ----
# local = 嵌入式（不需要 Docker，数据落在 QDRANT_PATH）；server = 连 Qdrant 服务
QDRANT_MODE=local
QDRANT_PATH=./.qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

# ---- embedding ----
# fastembed = 本地 ONNX 模型，不需要 key，首次会下载模型（约 90MB）
# openai / ollama = 走 API 或本地服务
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 必须和模型的输出维度一致：bge-small-zh = 512，text-embedding-3-small = 1536
EMBED_DIM=512
# 国内下载 HuggingFace 模型走镜像，否则会卡住
HF_ENDPOINT=https://hf-mirror.com

# ---- 检索参数（第 2 周会反复调这三个）----
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=8
RERANK_TOP_N=3

# 判分阈值：换 embedding 模型必须重新标定
# 实测参考（bge-small-zh-v1.5）：真相关问题 0.51~0.74，不相关 0.41~0.47
VECTOR_SCORE_THRESHOLD=0.50
KEYWORD_SCORE_THRESHOLD=0.22

# ---- 分流 ----
CLASSIFY_CONFIDENCE_THRESHOLD=0.7

# ---- 可观测 ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ---- 其他 ----
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
